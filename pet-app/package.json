{
  "name": "fairy-pet",
  "version": "0.1.0",
  "description": "Fairy 桌宠（Electron · 环形核 SVG 复刻）",
  "author": "allthetimes",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.allthetimes.fairypet",
    "productName": "FairyPet",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "ui/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "fairy-pet-setup-${version}.${ext}"
  }
}
